# Copy to .env. Everything is optional for local dev with the mock engines.

# --- Infrastructure (defaults target localhost; docker compose sets its own) ---
# GEOLENS_DATABASE_URL=postgresql+psycopg://geolens:geolens@localhost:5432/geolens
# GEOLENS_REDIS_URL=redis://localhost:6379/0
# GEOLENS_STORAGE_BACKEND=local            # local | s3
# GEOLENS_CELERY_EAGER=false               # true = run tasks inline (no worker)
# GEOLENS_AUDIT_ALLOW_PRIVATE_HOSTS=false  # never true in production (SSRF guard)

# --- Engine credentials: an engine is enabled when its key is set ---
# Model names change often; override with GEOLENS_<ENGINE>_MODEL, e.g. GEOLENS_DEEPSEEK_MODEL
# 国内 (collect.cn)
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
# GEOLENS_DOUBAO_MODEL=<your Ark endpoint / model id>
# Global (collect.global)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
